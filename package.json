{
  "name": "repolens",
  "version": "3.2.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:html": "node tools/check-html.mjs",
    "check:release": "node tools/check-release.mjs",
    "package": "node tools/package-extension.mjs",
    "package:check": "node tools/package-extension.mjs --check",
    "format": "prettier --write \"**/*.{js,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,html,md}\"",
    "verify": "npm test && npm run lint && npm run check:html && npm run format:check && npm run check:release && npm run package"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.13.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "vitest": "^4.1.9"
  }
}
