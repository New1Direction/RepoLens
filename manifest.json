{
  "manifest_version": 3,
  "name": "RepoLens",
  "version": "3.2.0",
  "description": "Click any repo. Get a straight answer on whether to use it.",
  "homepage_url": "https://new1direction.github.io/RepoLens/",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" },
  "permissions": ["storage", "activeTab", "identity", "notifications", "contextMenus", "alarms"],
  "host_permissions": [
    "https://github.com/*",
    "https://gitlab.com/*",
    "https://www.npmjs.com/*",
    "https://pypi.org/*",
    "https://api.github.com/*",
    "https://registry.npmjs.org/*",
    "https://api.anthropic.com/*",
    "https://console.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.x.ai/*",
    "https://auth.x.ai/*",
    "https://inference-api.nousresearch.com/*",
    "https://cli-chat-proxy.grok.com/*",
    "https://api.openai.com/*",
    "https://auth.openai.com/*",
    "https://chatgpt.com/*",
    "https://api.deepseek.com/*",
    "https://api.groq.com/*",
    "https://integrate.api.nvidia.com/*",
    "https://api.moonshot.ai/*",
    "https://api.moonshot.cn/*",
    "https://api.kimi.com/*",
    "https://open.bigmodel.cn/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.xiaomimimo.com/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://ollama.com/*",
    "https://api.minimax.io/*",
    "https://api.minimaxi.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*",
        "https://gitlab.com/*/*",
        "https://www.npmjs.com/package/*",
        "https://pypi.org/project/*"
      ],
      "js": ["src/content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "RepoLens — click to analyse",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
